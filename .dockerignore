# ==============================================================================
# .dockerignore for Retinal Disease Detection OCT
# Prevents bloat and keeps Docker build context lightweight and fast
# ==============================================================================

# Version control
.git
.gitignore
.gitattributes

# Python cache & compiled files
__pycache__
*/__pycache__
*/**/__pycache__
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.env
.venv/
venv/
env/
ENV/
build/
dist/

# Large training datasets & local data splits (empty locally or Hugging Face cache)
data/
*.h5
*.hdf5
*.parquet

# Large ML model binaries (saved as volumes in docker-compose.yml: - ./models:/app/models)
# Excluding .pt and .pkl saves ~2.33 GB of build context transfer!
# The models are mounted dynamically at container runtime.
models/*.pt
models/*.pkl
!models/README.md

# Presentation files and generation scripts (not needed inside container)
*.pptx
*.pdf
create_presentation.py

# IDE & system metadata
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db

# Testing and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs and scratch scripts
*.log
scratch/
